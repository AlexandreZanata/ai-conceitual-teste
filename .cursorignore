# Excluded from Cursor's index and from agent access.
# The repository is small by design (~60 tracked files) — this file only needs
# to keep generated bulk out. See docs/REPO-HYGIENE.md.

# --- Heavy regenerable output ---
data/
runs/
artifacts/
results/

# --- Environments and caches ---
node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.hf_cache/
wandb/

# --- Build ---
build/
dist/

# --- Binaries (never in the repo, but may exist on disk) ---
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.onnx
*.npy
*.npz
*.parquet
*.arrow

# --- Lockfiles and logs ---
package-lock.json
*.log
