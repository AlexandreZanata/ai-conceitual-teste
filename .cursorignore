# Excluded from Cursor's index and from agent access.
#
# Leading slash = anchored to repo root. WITHOUT it, `results/` would also block
# `docs/pipeline/results/` — the project scoreboard, which agents must read.

# --- Heavy regenerable output (root only) ---
/data/
/runs/
/artifacts/
/results/
/build/
/dist/
/node_modules/

# --- Environments and caches (any depth) ---
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.hf_cache/
wandb/

# --- Binaries (never committed, but may exist on disk) ---
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.onnx
*.npy
*.npz
*.parquet
*.arrow

# --- Lockfiles and logs ---
package-lock.json
*.log
