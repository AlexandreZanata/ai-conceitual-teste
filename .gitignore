# =============================================================================
# N32 .gitignore
#
# RULE: the repository holds SOURCE, CONFIG, SPECS, and SMALL JSON RESULTS.
# Everything a machine can regenerate stays out. See docs/REPO-HYGIENE.md.
#
# Nothing over 1 MB is ever committed without an explicit decision.
# =============================================================================

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# --- Private scratch --------------------------------------------------------
# Working notes for the active stage. Never required by another agent.
.local/
.cursor/rules/_task-active.mdc

# =============================================================================
# THE BIG FOUR — regenerable, and the reason most ML repos become unusable
# =============================================================================

# --- 1. Training data (~14 GB raw, ~8 GB tokenized) -------------------------
# Rebuild: npm run data:fetch && npm run data:clean && npm run data:dedup
# The MANIFEST with SHA-256 hashes is committed; the bytes are not.
data/*
!data/.gitkeep
!data/manifest.json

# --- 2. Model weights (13 MB - 200 MB each) ---------------------------------
# Distribute via HuggingFace Hub, never via git. See docs/REPO-HYGIENE.md.
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.onnx
*.ckpt
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.msgpack
artifacts/*
!artifacts/.gitkeep

# --- 3. Training runs (checkpoints + metrics streams) -----------------------
# Rebuild: npm run train. Only the final summary JSON is promoted to results/.
runs/*
!runs/.gitkeep

# --- 4. Run artifacts (heavy JSON dumps, plots, logs) -----------------------
# Committed EXCEPTION: small summary JSON referenced by a stage result.
# See docs/REPO-HYGIENE.md section "What may enter results/".
# `!results/**/` re-admits directories so git descends into them; without it the
# negations below can never match.
results/**
!results/**/
!results/.gitkeep
!results/**/summary.json
!results/**/*_summary.json

# --- Caches -----------------------------------------------------------------
.cache/
.hf_cache/
~/.cache/huggingface
wandb/
tensorboard/
lightning_logs/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
sdist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Node -------------------------------------------------------------------
node_modules/
dist/
coverage/
.turbo/
.next/
*.tsbuildinfo
.tmp/
npm-debug.log*

# --- C / C++ / CUDA ---------------------------------------------------------
cmake-build-*/
compile_commands.json
*.o
*.so
*.a
*.dylib

# --- Editors and OS ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# --- Notebooks --------------------------------------------------------------
# Outputs bloat diffs and leak data. Strip before committing (nbstripout).
.ipynb_checkpoints/

# --- Logs and profiles ------------------------------------------------------
*.log
*.prof
*.nsys-rep
*.sqlite
*.trace.json

# --- LaTeX ------------------------------------------------------------------
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.pdf
