# Local overrides and ephemeral Cursor task rules (not part of harness)
.local/
.cursor/rules/_task-active.mdc

# Environment and secrets
.env
.env.*
!.env.example

# OS and IDE (non-Cursor)
.DS_Store
.idea/
*.swp

# Python tooling (harness + quality scripts)
__pycache__/
.venv/
venv/
*.pyc
.pytest_cache/

# nano_lm Hugging Face / torch caches (weights stay local)
nano_lm/.cache/
nano_lm/.hf_cache/

# Curated public downloads (regenerate: npm run nano:curated)
nano_lm/data/curated/**
!nano_lm/data/curated/.gitkeep

# Node
node_modules/
dist/
coverage/
.turbo/
.next/
*.tsbuildinfo
.tmp/

# EvoGen experiment outputs (keep folder via .gitkeep)
results/*
!results/.gitkeep

# C++ build
build/
cmake-build-*/
compile_commands.json

# LaTeX paper build artifacts (sources stay; rebuild: npm run paper:build)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/main.pdf
