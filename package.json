{
  "name": "ai-conceitual-teste",
  "private": true,
  "version": "0.0.0",
  "description": "EvoGen — lightweight genetic + direct + selection learning research PoC (C++).",
  "scripts": {
    "prepare": "lefthook install || true",
    "verify": "bash scripts/check-quality.sh",
    "check:size": "python3 scripts/check_size_complexity.py --root .",
    "check:lint": "bash scripts/check-lint.sh",
    "check:system": "bash scripts/check-system.sh",
    "hooks:install": "lefthook install",
    "build": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel",
    "test": "ctest --test-dir build --output-on-failure",
    "evogen": "./build/evogen",
    "bench:smoke": "python3 scripts/run_survival_bench.py --bench TB-30 --technique R0 --technique C --seeds 2",
    "bench:aggregate": "python3 scripts/aggregate_survival_bench.py --out-csv docs/results/survival-benchmark-summary.csv",
    "bench:curves": "python3 scripts/export_survival_curves.py",
    "report:validate": "python3 scripts/validate_benchmark_report.py",
    "nano:test": "nano_lm/.venv/bin/python -m pytest nano_lm/tests -q",
    "nano:smoke": "nano_lm/.venv/bin/python nano_lm/src/run_bench.py nano_lm/configs/smoke.json",
    "nano:bench": "nano_lm/.venv/bin/python nano_lm/src/run_bench.py nano_lm/configs/bench.json",
    "nano:aggregate": "nano_lm/.venv/bin/python nano_lm/src/aggregate.py --runs results/nano-lm/smoke/runs.jsonl --out-md docs/results/nano-lm/smoke-summary.md --out-csv docs/results/nano-lm/smoke-summary.csv",
    "nano:lab": "nano_lm/.venv/bin/python nano_lm/src/lab.py configs/lab_gpu.json",
    "nano:lab:smoke": "nano_lm/.venv/bin/python nano_lm/src/lab.py configs/smoke.json",
    "nano:lab:bench": "nano_lm/.venv/bin/python nano_lm/src/lab.py configs/bench.json",
    "nano:matrix": "nano_lm/.venv/bin/python nano_lm/src/run_matrix.py",
    "nano:matrix:report": "nano_lm/.venv/bin/python nano_lm/src/write_matrix_report.py",
    "nano:spec": "nano_lm/.venv/bin/python nano_lm/src/run_spec_smoke.py",
    "nano:bal": "nano_lm/.venv/bin/python nano_lm/src/run_bal_smoke.py",
    "nano:dec": "nano_lm/.venv/bin/python nano_lm/src/run_dec_smoke.py",
    "nano:lam": "nano_lm/.venv/bin/python nano_lm/src/run_lam_smoke.py",
    "nano:eli": "nano_lm/.venv/bin/python nano_lm/src/run_eli_smoke.py",
    "nano:ent": "nano_lm/.venv/bin/python nano_lm/src/run_ent_smoke.py",
    "nano:ann": "nano_lm/.venv/bin/python nano_lm/src/run_ann_smoke.py",
    "nano:fit": "nano_lm/.venv/bin/python nano_lm/src/run_fit_smoke.py",
    "nano:tou": "nano_lm/.venv/bin/python nano_lm/src/run_tou_smoke.py",
    "nano:xov": "nano_lm/.venv/bin/python nano_lm/src/run_xov_smoke.py",
    "nano:nic": "nano_lm/.venv/bin/python nano_lm/src/run_nic_smoke.py",
    "nano:mut": "nano_lm/.venv/bin/python nano_lm/src/run_mut_smoke.py",
    "nano:ran": "nano_lm/.venv/bin/python nano_lm/src/run_ran_smoke.py",
    "nano:age": "nano_lm/.venv/bin/python nano_lm/src/run_age_smoke.py",
    "nano:mor": "nano_lm/.venv/bin/python nano_lm/src/run_mor_smoke.py",
    "nano:spe": "nano_lm/.venv/bin/python nano_lm/src/run_spe_smoke.py",
    "nano:sex": "nano_lm/.venv/bin/python nano_lm/src/run_sex_smoke.py",
    "nano:anti": "nano_lm/.venv/bin/python nano_lm/src/run_anti_smoke.py",
    "nano:tax": "nano_lm/.venv/bin/python nano_lm/src/run_tax_smoke.py",
    "nano:can": "nano_lm/.venv/bin/python nano_lm/src/run_can_smoke.py",
    "nano:par": "nano_lm/.venv/bin/python nano_lm/src/run_par_smoke.py",
    "nano:sym": "nano_lm/.venv/bin/python nano_lm/src/run_sym_smoke.py",
    "nano:fos": "nano_lm/.venv/bin/python nano_lm/src/run_fos_smoke.py",
    "nano:zom": "nano_lm/.venv/bin/python nano_lm/src/run_zom_smoke.py",
    "nano:lotu": "nano_lm/.venv/bin/python nano_lm/src/run_lotu_smoke.py",
    "nano:gld": "nano_lm/.venv/bin/python nano_lm/src/run_gld_smoke.py",
    "nano:sea": "nano_lm/.venv/bin/python nano_lm/src/run_sea_smoke.py",
    "nano:formal:hsel": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hsel.py",
    "nano:formal:hsel:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hsel_report.py",
    "lint": "node --check web/app.js"
  },
  "devDependencies": {
    "lefthook": "2.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
