{
  "name": "ai-conceitual-teste",
  "private": true,
  "version": "0.0.0",
  "description": "EvoGen \u2014 lightweight genetic + direct + selection learning research PoC (C++).",
  "scripts": {
    "prepare": "lefthook install || true",
    "verify": "bash scripts/check-quality.sh",
    "check:size": "python3 scripts/check_size_complexity.py --root .",
    "check:lint": "bash scripts/check-lint.sh",
    "check:system": "bash scripts/check-system.sh",
    "hooks:install": "lefthook install",
    "build": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel",
    "test": "ctest --test-dir build --output-on-failure",
    "evogen": "./build/evogen",
    "bench:smoke": "python3 scripts/run_survival_bench.py --bench TB-30 --technique R0 --technique C --seeds 2",
    "bench:aggregate": "python3 scripts/aggregate_survival_bench.py --out-csv docs/results/survival-benchmark-summary.csv",
    "bench:curves": "python3 scripts/export_survival_curves.py",
    "report:validate": "python3 scripts/validate_benchmark_report.py",
    "nano:test": "nano_lm/.venv/bin/python -m pytest nano_lm/tests -q",
    "nano:smoke": "nano_lm/.venv/bin/python nano_lm/src/run_bench.py nano_lm/configs/smoke.json",
    "nano:bench": "nano_lm/.venv/bin/python nano_lm/src/run_bench.py nano_lm/configs/bench.json",
    "nano:aggregate": "nano_lm/.venv/bin/python nano_lm/src/aggregate.py --runs results/nano-lm/smoke/runs.jsonl --out-md docs/results/nano-lm/smoke-summary.md --out-csv docs/results/nano-lm/smoke-summary.csv",
    "nano:lab": "nano_lm/.venv/bin/python nano_lm/src/lab.py configs/lab_gpu.json",
    "nano:lab:smoke": "nano_lm/.venv/bin/python nano_lm/src/lab.py configs/smoke.json",
    "nano:lab:bench": "nano_lm/.venv/bin/python nano_lm/src/lab.py configs/bench.json",
    "nano:matrix": "nano_lm/.venv/bin/python nano_lm/src/run_matrix.py",
    "nano:matrix:report": "nano_lm/.venv/bin/python nano_lm/src/write_matrix_report.py",
    "nano:spec": "nano_lm/.venv/bin/python nano_lm/src/run_spec_smoke.py",
    "nano:dec": "nano_lm/.venv/bin/python nano_lm/src/run_dec_smoke.py",
    "nano:deck": "nano_lm/.venv/bin/python nano_lm/src/run_deck_smoke.py",
    "nano:deck:report": "nano_lm/.venv/bin/python nano_lm/src/write_hdeck_report.py",
    "nano:deckl": "nano_lm/.venv/bin/python nano_lm/src/run_deckl_smoke.py",
    "nano:deckl:report": "nano_lm/.venv/bin/python nano_lm/src/write_hdeckl_report.py",
    "nano:pool": "nano_lm/.venv/bin/python nano_lm/src/run_pool_smoke.py",
    "nano:pool:report": "nano_lm/.venv/bin/python nano_lm/src/write_hpool_report.py",
    "nano:early": "nano_lm/.venv/bin/python nano_lm/src/run_early_smoke.py",
    "nano:early:report": "nano_lm/.venv/bin/python nano_lm/src/write_hearly_report.py",
    "nano:lay": "nano_lm/.venv/bin/python nano_lm/src/run_lay_smoke.py",
    "nano:lay:report": "nano_lm/.venv/bin/python nano_lm/src/write_hlay_report.py",
    "nano:amp": "nano_lm/.venv/bin/python nano_lm/src/run_amp_smoke.py",
    "nano:amp:report": "nano_lm/.venv/bin/python nano_lm/src/write_hamp_report.py",
    "nano:cur": "nano_lm/.venv/bin/python nano_lm/src/run_cur_smoke.py",
    "nano:cur:report": "nano_lm/.venv/bin/python nano_lm/src/write_hcur_report.py",
    "nano:curl": "nano_lm/.venv/bin/python nano_lm/src/run_curl_smoke.py",
    "nano:curl:report": "nano_lm/.venv/bin/python nano_lm/src/write_hcurl_report.py",
    "nano:curl2": "nano_lm/.venv/bin/python nano_lm/src/run_curl2_smoke.py",
    "nano:curl2:report": "nano_lm/.venv/bin/python nano_lm/src/write_hcurl2_report.py",
    "nano:stag": "nano_lm/.venv/bin/python nano_lm/src/run_stag_smoke.py",
    "nano:stag:report": "nano_lm/.venv/bin/python nano_lm/src/write_hstag_report.py",
    "nano:flop": "nano_lm/.venv/bin/python nano_lm/src/run_flop_smoke.py",
    "nano:flop:report": "nano_lm/.venv/bin/python nano_lm/src/write_hflop_report.py",
    "nano:formal:hdec": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hdec.py",
    "nano:formal:hdec:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hdec_report.py",
    "nano:formal:hdeck": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hdeck.py",
    "nano:formal:hdeck:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hdeck_report.py",
    "nano:formal:hdeckl": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hdeckl.py",
    "nano:formal:hdeckl:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hdeckl_report.py",
    "nano:formal:hpool": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hpool.py",
    "nano:formal:hpool:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hpool_report.py",
    "nano:formal:hearly": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hearly.py",
    "nano:formal:hearly:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hearly_report.py",
    "nano:formal:cur": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hcur.py",
    "nano:formal:cur:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hcur_report.py",
    "nano:formal:curl": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hcurl.py",
    "nano:formal:curl:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hcurl_report.py",
    "nano:formal:curl2": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hcurl2.py",
    "nano:formal:curl2:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hcurl2_report.py",
    "nano:formal:hstag": "nano_lm/.venv/bin/python nano_lm/src/run_formal_hstag.py",
    "nano:formal:hstag:report": "nano_lm/.venv/bin/python nano_lm/src/write_formal_hstag_report.py",
    "lint": "node --check web/app.js"
  },
  "devDependencies": {
    "lefthook": "2.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
