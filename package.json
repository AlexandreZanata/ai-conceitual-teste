{
  "name": "n32",
  "version": "0.1.0",
  "private": true,
  "description": "N32 — a 32k-context causal language model with <=60M non-embedding parameters, trained end to end on one consumer GPU",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "lefthook install",
    "verify": "bash scripts/check-quality.sh",
    "lint": "bash scripts/check-lint.sh",
    "test": "python3 -m pytest n32 bench -q",
    "hygiene": "python3 scripts/check_repo_hygiene.py",

    "hw:profile": "python3 bench/hw_profile.py --out results/hw/profile.json --sustained-minutes 10",
    "hw:budget": "python3 bench/compute_budget.py --profile results/hw/profile.json --out results/hw/budget.json",

    "data:fetch": "python3 -m n32.data.fetch",
    "data:clean": "python3 -m n32.data.clean",
    "data:dedup": "python3 -m n32.data.dedup",
    "data:tokenize": "python3 -m n32.data.tokenize",
    "data:stats": "python3 -m n32.data.stats",
    "data:instruct": "python3 -m n32.data.instruct",

    "tok:train": "python3 -m n32.tokenizer.train",
    "tok:eval": "python3 -m n32.tokenizer.evaluate",

    "train": "python3 -m n32.train.loop",
    "train:smoke": "python3 -m n32.train.loop --steps 100",
    "train:resume": "python3 -m n32.train.loop --resume",
    "train:sweep": "python3 -m n32.train.sweep",
    "train:extend": "python3 -m n32.train.extend",
    "train:sft": "python3 -m n32.train.sft",

    "eval:bpb": "python3 -m n32.eval.bpb",
    "eval:long": "python3 -m n32.eval.longctx.positional",
    "eval:needle": "python3 -m n32.eval.longctx.needle",
    "eval:ablation": "python3 -m n32.eval.longctx.ablation",
    "eval:tracking": "python3 -m n32.eval.longctx.tracking",
    "eval:gen": "python3 -m n32.eval.generation",
    "eval:bench": "python3 -m n32.eval.tasks",
    "eval:rag": "python3 -m n32.eval.rag",
    "eval:baselines": "python3 -m n32.eval.baselines",
    "eval:frontier": "python3 -m n32.eval.frontier",
    "eval:all": "python3 -m n32.eval.regression",

    "bench:throughput": "python3 bench/throughput.py",
    "bench:latency": "python3 bench/latency.py",
    "bench:memory": "python3 bench/memory.py",

    "rag:index": "python3 -m n32.serve.rag --build-index",
    "export:int8": "python3 -m n32.serve.quantize",
    "export:gguf": "python3 -m n32.serve.export_gguf",
    "serve": "python3 -m n32.serve.engine"
  },
  "devDependencies": {
    "lefthook": "^1.7.0"
  }
}
